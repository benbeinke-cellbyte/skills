{
  "name": "mattpocock-skills",
  "version": "1.2.3",
  "private": true,
  "description": "Cellbyte's cross-harness fork of Matt Pocock's engineering skills",
  "repository": {
    "type": "git",
    "url": "https://github.com/benbeinke-cellbyte/skills"
  },
  "license": "MIT",
  "keywords": [
    "pi-package",
    "agent-skills",
    "engineering"
  ],
  "pi": {
    "extensions": [
      "./extensions/question.ts"
    ],
    "skills": [
      "./skills/engineering",
      "./skills/productivity"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "scripts": {
    "changeset": "changeset",
    "version": "changeset version && node scripts/sync-plugin-version.mjs",
    "check-plugin-version": "node scripts/sync-plugin-version.mjs --check"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.30.0"
  },
  "packageManager": "npm@10.9.4"
}
